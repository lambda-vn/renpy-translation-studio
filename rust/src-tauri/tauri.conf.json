{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Renpy Translation Studio",
  "version": "2.0.0-rc.3",
  "identifier": "com.lambda-vn.renpy-translation-studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Ren'Py Translation Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Manage Ren'Py game translations",
    "longDescription": "Extract, review, machine-translate and export the translations of Ren'Py visual novels.",
    "copyright": "Copyright (C) 2026 lambda-vn, CeCILL-2.1",
    "license": "CECILL-2.1",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "renpy-translation-studio"
}
